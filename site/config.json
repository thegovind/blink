{
  "repo": "thegovind/blink",
  "branch": "main",
  "site_url": "https://thegovind.github.io/blink/",
  "space_url": "https://huggingface.co/spaces/thegovind/blink",
  "hub_url": "https://huggingface.co/",
  "models": ["blink-4b", "blink-mimo-9b", "blink-27b"],
  "example": {"case": "support", "label": "Double charge", "questions": ["queue", "urgency"]},
  "fonts_css": "https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500;600&display=swap",
  "katex": {
    "css": {"url": "https://cdn.jsdelivr.net/npm/katex@0.18.9/dist/katex.min.css", "integrity": "sha384-lPx0C4zIUZLpveABMwOFcFeGZwsvKBJfhJ85FN1PYOV7xApBcFMhcAEMVKF8loOI"},
    "js": {"url": "https://cdn.jsdelivr.net/npm/katex@0.18.9/dist/katex.min.js", "integrity": "sha384-19KE2cFb3U+RUWmyhBz7aLOGDG8WrRC6hE3oY/HTZZlAAVWYTdmvLC//+TIV3zUx"}
  },
  "mermaid": {
    "version": "11.17.2",
    "js": {"url": "https://cdn.jsdelivr.net/npm/mermaid@11.17.2/dist/mermaid.min.js", "integrity": "sha384-EOXBFmc3gx5mb+vn0vPvvGqACToJD24hhacX5Yx+8NUUQrHIle/Qi5Bg9o3zKwW2"},
    "config": {
      "startOnLoad": false,
      "securityLevel": "strict",
      "theme": "base",
      "fontFamily": "Geist, Inter, ui-sans-serif, system-ui, sans-serif",
      "themeVariables": {
        "darkMode": false,
        "fontFamily": "Geist, Inter, ui-sans-serif, system-ui, sans-serif",
        "fontSize": "14px",
        "background": "#ffffff",
        "primaryColor": "#ffffff",
        "primaryTextColor": "#0a0a0a",
        "primaryBorderColor": "#d4d4d4",
        "secondaryColor": "#fafafa",
        "secondaryTextColor": "#0a0a0a",
        "secondaryBorderColor": "#e5e5e5",
        "tertiaryColor": "#f5f5f5",
        "tertiaryTextColor": "#0a0a0a",
        "tertiaryBorderColor": "#e5e5e5",
        "lineColor": "#8c8c8c",
        "textColor": "#0a0a0a",
        "mainBkg": "#ffffff",
        "nodeBorder": "#d4d4d4",
        "nodeTextColor": "#0a0a0a",
        "clusterBkg": "#fafafa",
        "clusterBorder": "#e5e5e5",
        "titleColor": "#0a0a0a",
        "edgeLabelBackground": "#ffffff",
        "noteBkgColor": "#eef1fe",
        "noteTextColor": "#0a0a0a",
        "noteBorderColor": "#c3cefc",
        "actorBkg": "#ffffff",
        "actorBorder": "#d4d4d4",
        "actorTextColor": "#0a0a0a",
        "actorLineColor": "#d4d4d4",
        "signalColor": "#737373",
        "signalTextColor": "#0a0a0a",
        "labelBoxBkgColor": "#fafafa",
        "labelBoxBorderColor": "#d4d4d4",
        "labelTextColor": "#0a0a0a",
        "loopTextColor": "#0a0a0a",
        "activationBkgColor": "#eef1fe",
        "activationBorderColor": "#2447f5",
        "sequenceNumberColor": "#ffffff",
        "labelColor": "#0a0a0a",
        "altBackground": "#fafafa",
        "errorBkgColor": "#fef2f2",
        "errorTextColor": "#b91c1c"
      },
      "flowchart": {"curve": "basis", "padding": 14, "nodeSpacing": 36, "rankSpacing": 44, "htmlLabels": true},
      "sequence": {"useMaxWidth": true},
      "state": {"useMaxWidth": true}
    }
  }
